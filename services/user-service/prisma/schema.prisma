// This is your Prisma schema file for user-service

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  GSTIN
  BANK_STATEMENT
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  firstName   String?   @map("first_name") @db.VarChar(100)
  lastName    String?   @map("last_name") @db.VarChar(100)
  avatar      String?   @db.VarChar(500)
  email       String?   @unique @db.VarChar(255)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  city        String?   @db.VarChar(100)
  state       String?   @db.VarChar(100)
  pincode     String?   @db.VarChar(10)

  // Couple / event details
  partnerName    String?   @map("partner_name") @db.VarChar(100)
  weddingDate    DateTime? @map("wedding_date") @db.Date
  estimatedBudgetPaise Int? @map("estimated_budget_paise")
  guestCount     Int?      @map("guest_count")
  venueCity      String?   @map("venue_city") @db.VarChar(100)

  // Vendor-specific profile fields
  businessName   String?   @map("business_name") @db.VarChar(200)
  businessCity   String?   @map("business_city") @db.VarChar(100)

  // Notification preferences
  whatsappNotif  Boolean   @default(true) @map("whatsapp_notif")
  emailNotif     Boolean   @default(true) @map("email_notif")
  pushNotif      Boolean   @default(true) @map("push_notif")
  smsNotif       Boolean   @default(true) @map("sms_notif")

  pushTokens     PushToken[]
  kycDocuments   KycDocument[]

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model PushToken {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  token     String   @unique @db.VarChar(500)
  platform  String   @db.VarChar(20) // 'ios' | 'android' | 'web'
  deviceId  String?  @map("device_id") @db.VarChar(200)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([profileId])
  @@map("push_tokens")
}

model KycDocument {
  id         String       @id @default(uuid())
  profileId  String       @map("profile_id")
  profile    UserProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  docType    DocumentType @map("doc_type")
  s3Key      String       @map("s3_key") @db.VarChar(500)
  status     KycStatus    @default(PENDING)
  reviewNote String?      @map("review_note") @db.VarChar(500)
  reviewedAt DateTime?    @map("reviewed_at")
  reviewedBy String?      @map("reviewed_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([profileId])
  @@index([status])
  @@map("kyc_documents")
}

model ChecklistItem {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String   @db.VarChar(300)
  detail      String?  @db.VarChar(500)
  category    String   @default("other") @db.VarChar(50)
  isDone      Boolean  @default(false) @map("is_done")
  daysBeforeEvent Int? @map("days_before_event")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("checklist_items")
}

enum BudgetCategory {
  VENUE
  CATERING
  PHOTOGRAPHY
  VIDEOGRAPHY
  DECORATION
  MAKEUP
  MUSIC
  TRANSPORT
  INVITATION
  MEHENDI
  ATTIRE
  JEWELLERY
  GIFTS
  ACCOMMODATION
  HONEYMOON
  OTHER
}

model BudgetItem {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  category       BudgetCategory
  label          String         @db.VarChar(200)
  estimatedPaise Int            @map("estimated_paise")
  actualPaise    Int?           @map("actual_paise")
  vendorName     String?        @map("vendor_name") @db.VarChar(200)
  bookingId      String?        @map("booking_id")
  isPaid         Boolean        @default(false) @map("is_paid")
  notes          String?        @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([userId])
  @@map("budget_items")
}

enum GuestSide {
  BRIDE
  GROOM
  MUTUAL
}

enum GuestGroup {
  FAMILY
  FRIENDS
  COLLEAGUES
  NEIGHBOURS
  OTHERS
}

enum GuestRsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
  MAYBE
}

enum MealPref {
  VEG
  NON_VEG
  JAIN
  VEGAN
  NO_PREFERENCE
}

model Guest {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  name            String          @db.VarChar(200)
  phone           String?         @db.VarChar(20)
  email           String?         @db.VarChar(200)
  side            GuestSide       @default(MUTUAL)
  group           GuestGroup      @default(OTHERS)
  rsvpStatus      GuestRsvpStatus @default(PENDING) @map("rsvp_status")
  mealPreference  MealPref        @default(NO_PREFERENCE) @map("meal_preference")
  plusOnes        Int             @default(0) @map("plus_ones")
  tableNumber     String?         @map("table_number") @db.VarChar(50)
  roomAllocation  String?         @map("room_allocation") @db.VarChar(100)
  inviteSentAt    DateTime?       @map("invite_sent_at")
  rsvpRespondedAt DateTime?       @map("rsvp_responded_at")
  notes           String?         @db.VarChar(1000)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([userId])
  @@map("guests")
}
