generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  CREATED
  PENDING
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum EscrowStatus {
  HELD
  RELEASED_TO_VENDOR
  REFUNDED_TO_CUSTOMER
  DISPUTED
}

enum RefundReason {
  CANCELLATION
  DISPUTE_RESOLVED_CUSTOMER
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_CUSTOMER
  RESOLVED_VENDOR
  CLOSED
}

enum DisputeReason {
  no_show
  poor_quality
  late_arrival
  wrong_items
  overcharging
  cancellation
  rude_behaviour
  incomplete_service
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @map("booking_id")
  customerId        String        @map("customer_id")
  vendorId          String        @map("vendor_id")

  // Razorpay identifiers
  razorpayOrderId   String        @unique @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId String?       @unique @map("razorpay_payment_id") @db.VarChar(100)
  razorpaySignature String?       @map("razorpay_signature") @db.VarChar(300)

  amountPaise       Int           @map("amount_paise")
  currency          String        @default("INR") @db.VarChar(5)
  status            PaymentStatus @default(CREATED)
  description       String?       @db.VarChar(300)

  // Idempotency
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(100)

  // Webhook tracking
  webhookVerified   Boolean       @default(false) @map("webhook_verified")
  webhookReceivedAt DateTime?     @map("webhook_received_at")

  escrowHold        EscrowHold?

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([bookingId])
  @@index([customerId])
  @@index([status])
  @@map("payments")
}

model EscrowHold {
  id              String       @id @default(uuid())
  paymentId       String       @unique @map("payment_id")
  payment         Payment      @relation(fields: [paymentId], references: [id])
  bookingId       String       @map("booking_id")
  vendorId        String       @map("vendor_id")

  heldAmountPaise Int          @map("held_amount_paise")
  platformFeePaise Int         @map("platform_fee_paise")
  gstOnFeePaise   Int          @map("gst_on_fee_paise")
  vendorPayoutPaise Int        @map("vendor_payout_paise")

  status          EscrowStatus @default(HELD)
  releaseScheduledAt DateTime? @map("release_scheduled_at")
  releasedAt      DateTime?    @map("released_at")
  razorpayPayoutId String?     @map("razorpay_payout_id")
  adminNote       String?      @map("admin_note") @db.VarChar(500)

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([vendorId, status])
  @@index([bookingId])
  @@index([releaseScheduledAt])
  @@map("escrow_holds")
}

model Refund {
  id              String       @id @default(uuid())
  paymentId       String       @map("payment_id")
  bookingId       String       @map("booking_id")
  razorpayRefundId String?     @unique @map("razorpay_refund_id") @db.VarChar(100)
  amountPaise     Int          @map("amount_paise")
  reason          RefundReason @default(OTHER)
  note            String?      @db.VarChar(500)
  status          String       @default("PENDING") @db.VarChar(30)

  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([paymentId])
  @@map("refunds")
}

model Dispute {
  id              String        @id @default(uuid())
  bookingId       String        @map("booking_id")
  bookingNumber   String        @map("booking_number") @db.VarChar(30)
  customerId      String        @map("customer_id")
  vendorId        String        @map("vendor_id")

  // Names denormalised to avoid cross-service joins
  customerName    String        @map("customer_name") @db.VarChar(200)
  vendorName      String        @map("vendor_name") @db.VarChar(200)

  reason          DisputeReason
  description     String        @db.Text
  evidenceUrls    String[]      @map("evidence_urls")

  status          DisputeStatus @default(OPEN)
  refundAmountPaise Int?        @map("refund_amount_paise")
  adminNotes      String?       @map("admin_notes") @db.VarChar(2000)
  resolvedAt      DateTime?     @map("resolved_at")
  resolvedByAdminId String?     @map("resolved_by_admin_id")

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([bookingId])
  @@index([customerId])
  @@index([vendorId])
  @@index([status])
  @@map("disputes")
}
