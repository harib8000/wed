{
  "name": "@wedding-os/auth-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=.env watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "express": "^4.19.0",
    "@prisma/client": "^5.13.0",
    "redis": "^4.6.0",
    "ioredis": "^5.3.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.0",
    "jsonwebtoken": "^9.0.0",
    "bcrypt": "^5.1.0",
    "uuid": "^9.0.0",
    "axios": "^1.6.0",
    "bullmq": "^5.7.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.6",
    "@wedding-os/shared-events": "workspace:*",
    "@wedding-os/shared-errors": "workspace:*",
    "@wedding-os/shared-utils": "workspace:*",
    "@sentry/node": "^8.0.0",
    "prom-client": "^15.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "prisma": "^5.13.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/uuid": "^9.0.0",
    "@types/cors": "^2.8.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "@types/cookie-parser": "^1.4.7"
  }
}
