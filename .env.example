# ────────────────────────────────────────────────────────────────
# WeddingOS — Root Environment Variables
# Copy this file: cp .env.example .env
# ────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────
POSTGRES_USER=weddingos
POSTGRES_PASSWORD=weddingos_dev
POSTGRES_DB=weddingos_dev
DATABASE_URL=postgresql://weddingos:weddingos_dev@localhost:5432/weddingos_dev

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MongoDB (chat service) ──────────────────────────────────────
MONGODB_URL=mongodb://weddingos:mongo_dev_password@localhost:27017/weddingos_chat?authSource=admin

# ── Elasticsearch ────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── JWT (RS256) ──────────────────────────────────────────────────
# Generate keys: openssl genrsa -out keys/private.pem 2048
#                openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH=../../keys/private.pem
JWT_PUBLIC_KEY_PATH=../../keys/public.pem
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── AWS S3 / Cloudflare R2 ──────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=weddingos-dev-media

# ── SMS (MSG91) ──────────────────────────────────────────────────
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_template_id
MSG91_SENDER_ID=WEDDOS

# ── Firebase (Push Notifications) ────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project
FIREBASE_ADMIN_CREDENTIALS={"type":"service_account",...}

# ── SendGrid (Email) ────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@weddingos.in

# ── Google OAuth (optional) ─────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── Service Ports ────────────────────────────────────────────────
AUTH_SERVICE_PORT=4001
USER_SERVICE_PORT=4002
VENDOR_SERVICE_PORT=4003
BOOKING_SERVICE_PORT=4004
PAYMENT_SERVICE_PORT=4005
EXECUTION_SERVICE_PORT=4006
NOTIFICATION_SERVICE_PORT=4008
REVIEW_SERVICE_PORT=4009
CHAT_SERVICE_PORT=4010
SEARCH_SERVICE_PORT=4011
MEDIA_SERVICE_PORT=4012

# ── Inter-Service URLs ──────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
VENDOR_SERVICE_URL=http://localhost:4003
BOOKING_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005
NOTIFICATION_SERVICE_URL=http://localhost:4008
REVIEW_SERVICE_URL=http://localhost:4009

# ── Platform Config ─────────────────────────────────────────────
PLATFORM_FEE_PERCENT=10
ESCROW_RELEASE_DAYS_AFTER_EVENT=7
MAX_FILE_SIZE_MB=10
