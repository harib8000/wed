<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen background — gradient matching brand colors -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FAF5FF"
                android:endColor="#FDF4FF"/>
        </shape>
    </item>
    <!-- WeddingOS logo centered -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher"/>
    </item>
</layer-list>
