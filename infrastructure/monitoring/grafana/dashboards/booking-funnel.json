          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(payment_transactions_total{status=\"success\"}[5m])) / clamp_min(sum(rate(payment_transactions_total[5m])), 0.001)",
          "refId": "A"
