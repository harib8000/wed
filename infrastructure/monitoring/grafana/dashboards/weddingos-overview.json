        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * sum by (job) (rate(http_requests_total{job=~\".*-service\",status_code=~\"4..|5..\"}[5m])) / clamp_min(sum by (job) (rate(http_requests_total{job=~\".*-service\"}[5m])), 0.001)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Error Rate per Service",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
